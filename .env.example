# Application Settings
APP_NAME=HypeAI
DEBUG=false
ENVIRONMENT=production

# Database Settings
# PostgreSQL (for Docker/production)
POSTGRES_DB=hypeai
POSTGRES_USER=hypeai_user
POSTGRES_PASSWORD=changeme_secure_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://hypeai_user:changeme_secure_password@postgres:5432/hypeai

# For local development with SQLite (comment out PostgreSQL settings above)
# DATABASE_URL=sqlite+aiosqlite:///./hypeai.db

# Security Settings (CRITICAL: Generate secure keys for production!)
# Generate SECRET_KEY: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here-change-in-production
# Generate ENCRYPTION_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-base64-encoded-fernet-key-here

# Spotify OAuth2 Configuration
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
SPOTIFY_REDIRECT_URI=http://localhost:8000/auth/spotify/callback

# CORS Settings
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# JWT Settings
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# API Settings
MAX_PAGE_SIZE=100
DEFAULT_PAGE_SIZE=20

# Rate Limiting
SPOTIFY_RATE_LIMIT_PER_USER=10  # requests per 30 seconds
SPOTIFY_RATE_LIMIT_WINDOW=30     # seconds

# Token Settings
TOKEN_REFRESH_BUFFER_SECONDS=300  # Refresh tokens 5 minutes before expiry

# WebSocket Settings
WEBSOCKET_HEARTBEAT_INTERVAL=30   # seconds

# Workout Zone Thresholds (BPM)
ZONE_WARMUP_MIN=90
ZONE_WARMUP_MAX=110
ZONE_CARDIO_MIN=111
ZONE_CARDIO_MAX=140
ZONE_PEAK_MIN=141
ZONE_PEAK_MAX=220

# Logging
LOG_LEVEL=INFO

# Docker Compose Port Settings
API_PORT=8000
ADMINER_PORT=8080
