# Application Settings
APP_NAME=HypeAI
DEBUG=false
ENVIRONMENT=development

# Database
# For SQLite (development)
DATABASE_URL=sqlite+aiosqlite:///./hypeai.db
# For PostgreSQL (production)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/hypeai

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ENCRYPTION_KEY=your-base64-encoded-fernet-key-here

# Spotify OAuth2 Configuration
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
SPOTIFY_REDIRECT_URI=http://localhost:8000/auth/spotify/callback

# CORS Settings
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# API Settings
MAX_PAGE_SIZE=100
DEFAULT_PAGE_SIZE=20

# Rate Limiting
SPOTIFY_RATE_LIMIT_PER_USER=10  # requests per 30 seconds
SPOTIFY_RATE_LIMIT_WINDOW=30     # seconds

# Token Settings
TOKEN_REFRESH_BUFFER_SECONDS=300  # Refresh tokens 5 minutes before expiry

# WebSocket Settings
WEBSOCKET_HEARTBEAT_INTERVAL=30   # seconds

# Workout Zone Thresholds (BPM)
ZONE_WARMUP_MIN=90
ZONE_WARMUP_MAX=110
ZONE_CARDIO_MIN=111
ZONE_CARDIO_MAX=140
ZONE_PEAK_MIN=141
ZONE_PEAK_MAX=220

# Logging
LOG_LEVEL=INFO
